# ============================================================
# 大文件 / 模型（不进版本库）
# ============================================================
models/
*.safetensors
*.onnx
*.gguf
*.bin
.hf/

# ============================================================
# 私人记忆数据库（E-449：绝不能进版本库）
#
# 这些文件含真实私人记忆原文（偏好、习惯、项目细节）。
# 曾经被误跟踪过 8 个 .db.backup.*，已在 E-449 用
# git-filter-repo 从全部历史中清除（63.9MB → 6.7MB）。
#
# 注意：`*.db` 匹配不到 `dsh_mem.db.backup.20261110_172351`
#      （扩展名是 .20261110_172351），所以必须单独写规则。
# ============================================================
*.db
*.db-wal
*.db-shm
*.db.backup.*
*.db.backup
*.seed.json

# 用户数据目录（数据集、探针输出）
data/
_probe/

# ============================================================
# 实验中间产物（可由脚本重建）
# ============================================================
proto/work/*
proto/**/*.db
proto/**/*.db-wal
proto/**/*.db-shm
proto/data/
proto/archive/cosmos_lite/data/

# ============================================================
# 例外：版本清单必须进版本库
#
# versions.json 记录「哪个版本对应哪个 commit」，
# 是版本谱系（《环管群》的"管"层）的唯一真相来源。
#
# 它放在 proto/work/ 下（历史原因）。注意：
#   如果写成 `proto/work/`（忽略整个目录），
#   后面的 `!proto/work/versions.json` **不会生效** ——
#   git 不会进入被忽略的目录去检查白名单。
#   必须写成 `proto/work/*`（忽略内容但保留目录遍历）。
# ============================================================
!proto/work/versions.json

# ============================================================
# 缓存
# ============================================================
__pycache__/
*.pyc
*.pyo
.pip-tmp/
.tmp/
node_modules/
.pytest_cache/

# 归档目录里的特征缓存与模型权重（可重新生成，101MB）
proto/archive/cosmos_lite/cache/
*.npz
*.pth
*.pt

# ============================================================
# 调试日志
# ============================================================
proto/cosmos_mem/plugin-debug.jsonl
*.log

# ============================================================
# 系统
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.orig

# ============================================================
# 注意：proto/results/ 要进版本库
#   实验结果是"数据证据"，是迭代决策的依据，必须可追溯。
#   体积只有 1.3MB，值得保留。
# ============================================================

dist/

# 异地同步的本机状态（含时间戳/路径，不该入库）
proto/cosmos_mem/offsite_state.json

# itsaplan 数据库备份（含敏感数据，不入库）
scripts/backups/*.sql
proto/archive/

# 部署配置（含密钥，不入库）
deploy/**/.env
deploy/itsaplan/
