# Caddyfile —— B 路线：tls internal 自签 HTTPS（纯局域网）
#
# 使用前：把下面 <IP> 替换成 Windows 主机当前局域网 IP（如 <IP>）
# 访问方式：https://<IP>
# ⚠ 每台客户端必须先导入 Caddy 根证书，否则浏览器报 NET::ERR_CERT_AUTHORITY_INVALID

# 全局：用 Caddy 内置本地 CA（对所有 site 生效，IP 地址不会自动签，必须显式）
{
    local_certs
}

<IP>:443 {
    # ★ 纯 IP 必须显式 tls internal（Caddy 默认不给裸 IP 签证书）
    tls internal

    # ---- itsaplan API ----
    # handle_path 自动去掉 /api 前缀；API_URL=https://<IP>/api
    handle_path /api/* {
        reverse_proxy itsaplan-api:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }

    # ---- MCP OAuth discovery ----
    # ★ 必须用 handle（保留完整路径），不能用 handle_path！
    # 源码 apps/api/src/app.ts L318-320（RFC 8414 §3）：
    #   issuer 带路径时，discovery = /.well-known/<doc>/<路径>
    #   API_URL 带 /api → 客户端请求 /.well-known/oauth-authorization-server/api
    #   api 内部路由 /.well-known/oauth-authorization-server/* 接住，* = "api" ✓
    handle /.well-known/oauth-authorization-server* {
        reverse_proxy itsaplan-api:3000
    }
    handle /.well-known/oauth-protected-resource* {
        reverse_proxy itsaplan-api:3000
    }
    handle /.well-known/openid-configuration* {
        reverse_proxy itsaplan-api:3000
    }

    # ---- itsaplan Web（兜底）----
    handle {
        reverse_proxy itsaplan-web:3001 {
            header_up X-Real-IP {remote_host}
        }
    }
}

# 说明：
# - local_certs + tls internal 用 Caddy 自带 CA，签给 IP 的证书
# - 根证书位置：容器 /data/pki/authorities/local/root.crt
#   导出：docker cp caddy:/data/pki/authorities/local/root.crt ./caddy-root.crt
#   然后在每台客户端导入"受信任的根证书颁发机构"
# - 80 端口：Caddy 默认对 443 site 做 HTTP→HTTPS 跳转（本文件没写 :80 site，
#   但 Caddy 会自动为 443 site 监听 80 并跳转）
