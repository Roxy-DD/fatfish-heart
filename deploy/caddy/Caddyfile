{
	auto_https disable_redirects
}

# ★ 为什么用域名而不是 IP：
#   Windows 的 schannel（curl/浏览器实际用的 TLS 栈）不支持对纯 IP 发 SNI：
#     curl 报 "using IP address, SNI is not supported by OS"
#   无 SNI 时 Caddy 找不到匹配的证书 → 返回 TLS alert 80。
#
#   解法：用域名访问，客户端会正常发 SNI。
#   在 C:\Windows\System32\drivers\etc\hosts 里加一行：
#     172.20.10.5  itsaplan.lan
#   然后访问 https://itsaplan.lan

itsaplan.lan:80 {
	redir https://{host}{uri} permanent
}

itsaplan.lan:443 {
	tls internal

	handle_path /api/* {
		reverse_proxy itsaplan-api:3000
	}
	handle /.well-known/oauth-authorization-server* {
		reverse_proxy itsaplan-api:3000
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy itsaplan-api:3000
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy itsaplan-api:3000
	}
	handle {
		reverse_proxy itsaplan-web:3001
	}
}
